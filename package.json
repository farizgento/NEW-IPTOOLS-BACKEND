{
  "name": "iptools-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend IP TOOLS — aturan bisnis di lapisan service, bukan di basis data",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file=.env --watch -r ts-node/register src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:tonton": "vitest",
    "periksa": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@types/multer": "^2.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "oracledb": "^6.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/oracledb": "^6.9.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
