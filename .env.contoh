# Salin menjadi .env lalu sesuaikan. Berkas .env tidak masuk repositori.
NODE_ENV=development
PORT=3001

DB_HOST=localhost
DB_PORT=1521
DB_SERVICE=XEPDB1
DB_USER=IPTOOLS_NEW
DB_PASSWORD=ganti-dengan-sandi-anda
DB_POOL_MIN=1
DB_POOL_MAX=10

# Minimal 32 karakter. Terbitkan acak, jangan pakai contoh ini apa adanya:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_RAHASIA=ganti-dengan-kunci-acak-minimal-32-karakter
JWT_UMUR_DETIK=3600

# Menerima username apa pun tanpa memeriksa sandi — pengembangan lokal saja.
# Aplikasi menolak menyala bila ini true saat NODE_ENV=production.
AUTH_LEWATI_DIREKTORI=true

# Alamat frontend; dipakai menyusun tautan konfirmasi di pesan ke peminjam
WEB_URL=http://localhost:5173

# Penyimpanan berkas lampiran
LAMPIRAN_DIREKTORI=./data/lampiran
LAMPIRAN_MAKS_BITA=10485760

# Pengingat berjenjang
PENGINGAT_AKTIF=true
PENGINGAT_JEDA_MENIT=60
